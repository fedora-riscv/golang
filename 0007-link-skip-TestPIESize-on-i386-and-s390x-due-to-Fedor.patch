From 933b76355970b546698c2305d7d4077bb608b0b5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alejandro=20S=C3=A1ez?= <asm@redhat.com>
Date: Tue, 12 Nov 2024 17:30:14 +0100
Subject: [PATCH] link: skip TestPIESize on i386 and s390x due to Fedora CI
 issues

---
 src/cmd/link/elf_test.go | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/cmd/link/elf_test.go b/src/cmd/link/elf_test.go
index 5dcef1cc22..79b4e3f7da 100644
--- a/src/cmd/link/elf_test.go
+++ b/src/cmd/link/elf_test.go
@@ -318,6 +318,10 @@ func TestPIESize(t *testing.T) {
 	if !platform.BuildModeSupported(runtime.Compiler, "pie", runtime.GOOS, runtime.GOARCH) {
 		t.Skip("-buildmode=pie not supported")
 	}
+	// There is a problem with x86 and s390x in the Fedora builders so we skip them.
+	if runtime.GOARCH == "386" || runtime.GOARCH == "s390x" {
+		t.Skipf("skipping on %s due to Fedora CI issues", runtime.GOARCH)
+	}
 
 	t.Parallel()
 
-- 
2.47.0

